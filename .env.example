# For Monad Testnet deployment. Never commit real keys.
DEPLOYER_PRIVATE_KEY=
WAREHOUSE_PRIVATE_KEY=
WAREHOUSE_ADDRESS=
SUPPLIER_ADDRESS=
# Isolated test-only supplier signer for guided localhost rehearsal. Never NEXT_PUBLIC.
SUPPLIER_PRIVATE_KEY=
BUYER_PRIVATE_KEY=
BUYER_ADDRESS=
# V3 third-party funding account; server-only test credentials.
LENDER_PRIVATE_KEY=
LENDER_ADDRESS=
# Explicitly enable only for the dedicated testnet/local deployment and local presenter host.
GUIDED_DEMO_ENABLED=true
WAREHOUSE_API_TOKEN=
# Optional RPC override. Default comes from backend/config/networks.json.
RPC_URL=

# Optional writable persistent directory for demo round selection on a Node/Docker host.
# DEMO_SESSION_DIR=/data/traderail-demo

# Optional V3 server-only RPC override. Never embed private RPC credentials in metadata.
TRADERAIL_RPC_URL=
